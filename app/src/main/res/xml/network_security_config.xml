<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenCurv talks to exactly two servers, and only to fetch offline data the
  rider explicitly asked for. Navigation itself never uses the network.

  Everything else is denied by the platform, not merely avoided by our code:
  cleartext is off everywhere, and no other domain is listed. A bug, a bad
  catalog entry or a redirect cannot widen this.

  Map rendering (MapLibre) needs no entry here at all: the style JSON, the
  glyph PBFs and the PMTiles vector-tile archive are all read from the
  device (asset:// and pmtiles://file://), never fetched over HTTP. Verified
  in airplane mode - see 1.Doku/Karte_MapLibre.md.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="false">
        <!-- Mapsforge vector maps (.map) -->
        <domain includeSubdomains="false">download.mapsforge.org</domain>
        <!-- BRouter routing tiles (.rd5) -->
        <domain includeSubdomains="false">brouter.de</domain>
        <!-- GitHub release downloads (.pmtiles, .rd5, catalog.json) -->
        <domain includeSubdomains="false">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <!-- BMDV/Autobahn GmbH open traffic API (closures, roadworks, warnings) -->
        <domain includeSubdomains="false">verkehr.autobahn.de</domain>
    </domain-config>
</network-security-config>
