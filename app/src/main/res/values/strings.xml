    <string name="onboarding_welcome_title">Curves, not arrival times</string>
    <string name="onboarding_welcome_body">OpenCurv looks for the winding road, not the quick one. It works completely offline: maps, routing and voice all run on the phone, and your position never leaves it.</string>
    <string name="onboarding_data_title">One download, then no network</string>
    <string name="onboarding_data_body">You need one region: a map to draw and the routing tiles to calculate with. OpenCurv fetches both from a public database in one package — figure on 300 MB to 1.5 GB, so do it on Wi-Fi.</string>
    <string name="onboarding_region_title">Pick your region</string>
    <string name="onboarding_region_body">Choose the area you ride in. It is downloaded as one package and deleted as one package, and you can add more later.</string>
