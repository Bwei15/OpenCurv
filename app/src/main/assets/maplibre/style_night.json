{
  "version": 8,
  "name": "OpenCurv",
  "metadata": {
    "opencurv:register": "night",
    "opencurv:derivedFrom": "style_day.json via HSL lightness inversion (L' = 1 - L)"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "__PMTILES_URL__"
    }
  },
  "glyphs": "asset://maplibre/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#17150E"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "in",
          "class",
          "residential",
          "suburb",
          "neighbourhood"
        ]
      ],
      "paint": {
        "fill-color": "#1D1A12",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "grass"
      ],
      "paint": {
        "fill-color": "#15290F",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "#1E3C15",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "!=",
          "intermittent",
          1
        ]
      ],
      "paint": {
        "fill-color": "#204955"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#204955",
        "line-width": {
          "base": 1.4,
          "stops": [
            [
              8,
              1
            ],
            [
              18,
              4
            ]
          ]
        }
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#2A2820",
        "fill-opacity": {
          "base": 1,
          "stops": [
            [
              13,
              0
            ],
            [
              15,
              0.65
            ]
          ]
        },
        "fill-outline-color": "#39362C"
      }
    },
    {
      "id": "road_minor_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "minor",
          "service"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#312D23",
        "line-width": {
          "base": 1.4,
          "stops": [
            [
              12,
              1.8
            ],
            [
              15,
              4.5
            ],
            [
              18,
              14
            ]
          ]
        }
      }
    },
    {
      "id": "road_minor_core",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "minor",
          "service"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#000000",
        "line-width": {
          "base": 1.4,
          "stops": [
            [
              12,
              1
            ],
            [
              15,
              3.2
            ],
            [
              18,
              11
            ]
          ]
        }
      }
    },
    {
      "id": "road_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "primary",
          "secondary",
          "tertiary",
          "trunk"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#936F1A",
        "line-width": {
          "base": 1.4,
          "stops": [
            [
              6,
              2
            ],
            [
              11,
              4.8
            ],
            [
              14,
              8
            ],
            [
              18,
              18
            ]
          ]
        }
      }
    },
    {
      "id": "road_major_core",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "primary",
          "secondary",
          "tertiary",
          "trunk"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#7D5E00",
        "line-width": {
          "base": 1.4,
          "stops": [
            [
              6,
              1.2
            ],
            [
              11,
              3.2
            ],
            [
              14,
              6
            ],
            [
              18,
              14
            ]
          ]
        }
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name:latin}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": {
          "base": 1.2,
          "stops": [
            [
              12,
              9
            ],
            [
              17,
              11
            ]
          ]
        }
      },
      "paint": {
        "text-color": "#858A8F",
        "text-halo-color": "#000000",
        "text-halo-width": 2
      }
    },
    {
      "id": "poi_fuel_pin",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 11,
      "filter": [
        "in",
        "class",
        "fuel",
        "petrol"
      ],
      "paint": {
        "circle-radius": {
          "base": 1.4,
          "stops": [
            [
              11,
              4.5
            ],
            [
              14,
              7
            ],
            [
              17,
              10
            ]
          ]
        },
        "circle-color": "#1770E5",
        "circle-stroke-color": "#000000",
        "circle-stroke-width": 2
      }
    },
    {
      "id": "poi_fuel_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": [
        "in",
        "class",
        "fuel",
        "petrol"
      ],
      "layout": {
        "text-anchor": "left",
        "text-field": "{name:latin}",
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": 11,
        "text-offset": [
          0.9,
          0
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#4385E7",
        "text-halo-color": "#000000",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "poi_food_pin",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "restaurant",
        "cafe",
        "fast_food"
      ],
      "paint": {
        "circle-radius": 5,
        "circle-color": "#CA2315",
        "circle-stroke-color": "#000000",
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "poi_food_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": [
        "in",
        "class",
        "restaurant",
        "cafe",
        "fast_food"
      ],
      "layout": {
        "text-anchor": "left",
        "text-field": "{name:latin}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-offset": [
          0.8,
          0
        ]
      },
      "paint": {
        "text-color": "#E03D3A",
        "text-halo-color": "#000000",
        "text-halo-width": 2
      }
    },
    {
      "id": "place_label_town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Point"
        ],
        [
          "in",
          "class",
          "city",
          "town",
          "village",
          "suburb"
        ]
      ],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": {
          "stops": [
            [
              8,
              11
            ],
            [
              14,
              13
            ]
          ]
        },
        "text-letter-spacing": 0.04,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#BCC0C3",
        "text-halo-color": "#000000",
        "text-halo-width": 2.5
      }
    }
  ],
  "id": "opencurv"
}
